# Turns the planner's free-text box into a real conversation.
# Set one of these. Without either, the planner keeps using its own
# deterministic matching and the page works exactly as it does now.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional. Defaults to claude-sonnet-5 / gpt-4o-mini for the provider above.
# PLANNER_MODEL=
