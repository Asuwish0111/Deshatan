# ---- Database ----------------------------------------------------
# Leave DATABASE_URL empty to run in file mode (.data/db.json) - zero setup, good for dev.
# Set it to a Postgres URL (Neon / Supabase / Railway) for production.
DATABASE_URL=

# ---- Admin login -------------------------------------------------
ADMIN_EMAIL=admin@deshatan.in
ADMIN_PASSWORD=deshatan123
SESSION_SECRET=change-this-to-a-long-random-string

# ---- Payments (Razorpay) -----------------------------------------
# Leave empty to run payments in MOCK mode (no real money, instant success).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
